[Unit]
Description=Patternflood demos (2x2 P2 panels via Colorlight 5A-75B / receiver75)
# Not After=cloud-final.service: cloud-final runs after multi-user.target, which waits
# for this unit, so that's an ordering cycle and systemd drops this unit's start job.
# The numpy check below retries until cloud-init's first-boot install lands.
After=network.target
StartLimitIntervalSec=0

[Service]
# The frame loop says READY=1 on its first frame and WATCHDOG=1 about once a second, so a renderer that
# hangs (a pattern stuck in a loop, I/O that never returns) is killed and restarted, not left frozen.
# Start-up may compile the presets first: minutes on a Zero W. (The kernel and systemd themselves are
# covered by Raspberry Pi OS's default RuntimeWatchdogSec=1min on the hardware watchdog.)
Type=notify
NotifyAccess=main
WatchdogSec=20
TimeoutStartSec=30min
User=patternflood
Group=patternflood
WorkingDirectory=/opt/patternflood/demos
# Settings: the defaults here, overridden by /etc/default/patternflood (edit it, then
# `sudo systemctl restart patternflood`).
Environment=PF_ONLY= PF_DEMO=0 PF_FPS=60 PF_BRIGHT=0.3 PF_KNOBS=i2c:1 PF_OUT=udp:192.168.75.39 PF_AUDIO=none
EnvironmentFile=-/etc/default/patternflood
# Boot splash step 5: the renderer is starting (importing numpy takes a while).
ExecStartPre=-+/usr/local/sbin/pf-splash -t 10 5
# Steady frame timing: no clocking down between frames.
ExecStartPre=+/bin/sh -c 'for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do echo performance > $$g; done || true'
# numpy arrives with cloud-init's first-boot package install; until then, retry.
ExecStartPre=/usr/bin/python3 -c "import numpy"
# The upstream presets compile on the first start after g++ lands (a few minutes on a
# Zero W, behind splash step 5), into a directory the renderer owns.
ExecStartPre=+/bin/chown -R patternflood:patternflood /opt/patternflood/demos/upstream_host/build
ExecStart=/usr/bin/python3 -u /opt/patternflood/demos/run.py --knobs ${PF_KNOBS} --out ${PF_OUT} \
    --only ${PF_ONLY} --demo ${PF_DEMO} --fps ${PF_FPS} --bright ${PF_BRIGHT} --audio ${PF_AUDIO}
# Back to the card's spinner while stopped or restarting, rather than a dark box.
ExecStopPost=-+/usr/local/sbin/pf-splash -t 5 --show 5
Nice=-5
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
