#!/bin/sh
# Patternflood login header: wordmark, then what the box is doing.
# Provisioned from patternflood firmware/pi-controller; keep it quick, it runs at every login.

echo
printf '  \033[38;5;238m░\033[38;5;51m█▀█\033[38;5;238m░\033[38;5;50m█▀\033[38;5;45m█\033[38;5;238m░\033[38;5;45m▀█\033[38;5;44m▀\033[38;5;238m░\033[38;5;44m▀\033[38;5;39m█▀\033[38;5;238m░\033[38;5;39m█\033[38;5;38m▀▀\033[38;5;238m░\033[38;5;33m█▀▄\033[38;5;238m░\033[38;5;32m█▀█\033[38;5;238m░\033[38;5;27m█▀\033[38;5;63m▀\033[38;5;238m░\033[38;5;63m█\033[38;5;238m░░░\033[38;5;62m█\033[38;5;99m▀█\033[38;5;238m░\033[38;5;99m█\033[38;5;98m▀█\033[38;5;238m░\033[38;5;135m█▀▄\033[0m\n'
printf '  \033[38;5;238m░\033[38;5;51m█▀▀\033[38;5;238m░\033[38;5;50m█▀\033[38;5;45m█\033[38;5;238m░░\033[38;5;45m█\033[38;5;238m░░░\033[38;5;39m█\033[38;5;238m░░\033[38;5;39m█\033[38;5;38m▀▀\033[38;5;238m░\033[38;5;33m█▀▄\033[38;5;238m░\033[38;5;32m█\033[38;5;238m░\033[38;5;32m█\033[38;5;238m░\033[38;5;27m█▀\033[38;5;63m▀\033[38;5;238m░\033[38;5;63m█\033[38;5;238m░░░\033[38;5;62m█\033[38;5;238m░\033[38;5;99m█\033[38;5;238m░\033[38;5;99m█\033[38;5;238m░\033[38;5;98m█\033[38;5;238m░\033[38;5;135m█\033[38;5;238m░\033[38;5;135m█\033[0m\n'
printf '  \033[38;5;238m░\033[38;5;51m▀\033[38;5;238m░░░\033[38;5;50m▀\033[38;5;238m░\033[38;5;45m▀\033[38;5;238m░░\033[38;5;45m▀\033[38;5;238m░░░\033[38;5;39m▀\033[38;5;238m░░\033[38;5;39m▀\033[38;5;38m▀▀\033[38;5;238m░\033[38;5;33m▀\033[38;5;238m░\033[38;5;33m▀\033[38;5;238m░\033[38;5;32m▀\033[38;5;238m░\033[38;5;32m▀\033[38;5;238m░\033[38;5;27m▀\033[38;5;238m░░░\033[38;5;63m▀▀\033[38;5;62m▀\033[38;5;238m░\033[38;5;62m▀\033[38;5;99m▀▀\033[38;5;238m░\033[38;5;99m▀\033[38;5;98m▀▀\033[38;5;238m░\033[38;5;135m▀▀\033[38;5;238m░\033[0m\n'
printf '  \033[38;5;51m▁▂▃▄\033[38;5;50m▅▆▇\033[38;5;45m█▇▆▅\033[38;5;44m▄▃▂\033[38;5;39m▁▂▃▄\033[38;5;38m▅▆▇\033[38;5;33m█▇▆\033[38;5;32m▅▄▃▂\033[38;5;27m▁▂▃\033[38;5;63m▄▅▆▇\033[38;5;62m█▇▆\033[38;5;99m▅▄▃▂\033[38;5;98m▁▂▃\033[38;5;135m▄▅▆\033[0m\n'
board=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null | sed 's/^Raspberry //; s/ Rev .*//; s/ Model B$//')
printf '  \033[2m2x2 P2 panels  -  Colorlight 5A-75B / receiver75  -  %s\033[0m\n\n' "${board:-Pi}"

ok='\033[38;5;79m'; bad='\033[38;5;203m'; dim='\033[2m'; off='\033[0m'
line() { printf "  ${dim}%-9s${off} %b%s${off}\n" "$1" "$2" "$3"; }

state=$(systemctl is-active patternflood.service 2>/dev/null)
[ "$state" = active ] && line renderer "$ok" "$state" || line renderer "$bad" "${state:-unknown}"

nic=$(ip -o -4 addr show 2>/dev/null | awk '/ 192\.168\.75\.1\//{print $2; exit}')
if [ -n "$nic" ] && [ "$(cat /sys/class/net/$nic/carrier 2>/dev/null)" = 1 ]; then
    line card "$ok" "link on $nic"
elif [ -n "$nic" ]; then
    line card "$bad" "no link on $nic"
else
    line card "$bad" "no 192.168.75.1 interface (Ethernet to the card?)"
fi

if command -v vcgencmd >/dev/null 2>&1; then
    temp=$(vcgencmd measure_temp 2>/dev/null | cut -d= -f2)
    t=$(vcgencmd get_throttled 2>/dev/null | cut -d= -f2)
    case "$t" in
    0x0)  line power "$ok" "ok  ${temp}" ;;
    "")   ;;
    *)    v=$(( t ))
          if [ $(( v & 0x1 )) -ne 0 ]; then msg="under-voltage now"
          elif [ $(( v & 0x10000 )) -ne 0 ]; then msg="under-voltage since boot"
          else msg="throttled"; fi
          line power "$bad" "$msg ($t)  ${temp}" ;;
    esac
fi
echo
