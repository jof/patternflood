From 74a525ecb9720b30916a662779cf5aaf6a9cb176 Mon Sep 17 00:00:00 2001
From: Jonathan Lassoff <jof@thejof.com>
Date: Wed, 21 Oct 2026 21:59:36 -0700
Subject: [PATCH 1/3] BIOS: keep build-time IP when flash config is blank; add
 crt0.o rule

Erased flash reads as all ones, which made the card 255.255.255.255 with
an all-ones MAC. Without a crt0.o rule, make silently skipped linking
bios.elf.
---
 bios/Makefile | 4 ++++
 bios/main.c   | 8 ++++++--
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/bios/Makefile b/bios/Makefile
index 33cf030..62c5aa5 100644
--- a/bios/Makefile
+++ b/bios/Makefile
@@ -42,6 +42,10 @@ endif
 %.o: $(BIOS_DIRECTORY)/%.S
 	$(assemble)
 
+# As in LiteX's own BIOS Makefile; without it make silently skips linking bios.elf.
+crt0.o: $(CPU_DIRECTORY)/crt0.S
+	$(assemble)
+
 clean:
 	$(RM) $(OBJECTS) bios.elf bios.bin .*~ *~
 
diff --git a/bios/main.c b/bios/main.c
index a82715b..1552497 100644
--- a/bios/main.c
+++ b/bios/main.c
@@ -56,8 +56,12 @@ int main(int i, char **c)
     mac_addr |= spi_flash_read(config_idx++) & 0xff; mac_addr <<= 8;
     mac_addr |= spi_flash_read(config_idx++) & 0xff;
 
-    hub75_soc_mac_address_write(mac_addr);
-    hub75_soc_ip_address_write(ip_addr);
+    // Blank (erased) flash reads as all ones: keep the build-time IP and the
+    // default MAC instead of becoming 255.255.255.255 / ff:ff:ff:ff:ff:ff.
+    if (ip_addr != 0xffffffff) {
+        hub75_soc_mac_address_write(mac_addr);
+        hub75_soc_ip_address_write(ip_addr);
+    }
 #endif
 
     sdram_init();
-- 
