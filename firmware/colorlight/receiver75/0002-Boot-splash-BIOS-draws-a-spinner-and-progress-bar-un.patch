diff --git a/bios/splash.c b/bios/splash.c
new file mode 100644
index 0000000..f93c5dc
--- /dev/null
+++ b/bios/splash.c
@@ -0,0 +1,247 @@
+// SPDX-License-Identifier: MIT
+//
+// Boot splash: a spinner and a five-step progress bar, drawn into framebuffer
+// bank 2 from power-on until a host takes the display by pointing base_addr at
+// bank 0 or 1 (patternflood's knob_renderer.py does, every frame).
+//
+// A host moves the bar on by writing the step, 1-5, to ctrl_scratch over UDP
+// port 4344; patternflood's pf-splash does that from the Pi's initramfs and
+// systemd. Pointing base_addr back at bank 2 brings the splash back.
+//
+// The CPU can only write the SDRAM, a 64-bit word at a time (CsrDramWriter), so
+// the splash is redrawn in whole words from a scene function.
+
+#include <stdint.h>
+
+#include <generated/csr.h>
+#include <generated/soc.h>
+
+#include "splash.h"
+
+#define SLOTS       16
+#define SLOT_WORDS  (64 * 48)       // 64 rows of 64 RGB pixels, in 32-bit words
+#define SPLASH_BASE (2 * SLOTS * SLOT_WORDS)    // the host double-buffers in banks 0 and 1
+#define STEPS       5
+#define DOTS        12
+#define FRAME_TICKS (CONFIG_CLOCK_FREQUENCY / 1000 * 80)
+
+// The 2x2's quadrants -> receiver75 slots, as wired in the desktop box
+// (patternflood firmware/colorlight/r75_frame.py, QUADRANT_SLOTS).
+static const uint8_t quadrant_slot[2][2] = { { 9, 15 }, { 7, 1 } };
+
+// Spinner: DOTS dots on a ring of radius 24; each dot is 5x5 less its corners.
+#define CX 64
+#define CY 54
+static const int8_t ring[DOTS][2] = {
+    {   0, -24 }, {  12, -21 }, {  21, -12 }, {  24,   0 },
+    {  21,  12 }, {  12,  21 }, {   0,  24 }, { -12,  21 },
+    { -21,  12 }, { -24,   0 }, { -21, -12 }, { -12, -21 },
+};
+
+// Bar: STEPS segments of 16 x 4, 4 apart, centred under the spinner.
+#define BAR_X   16
+#define BAR_Y   96
+#define SEG_W   16
+#define SEG_GAP 4
+#define SEG_H   4
+
+// Raw channel values, no gamma. Dim: it's up for seconds to minutes.
+#define RGB(r, g, b) (((uint32_t)(r) << 16) | ((uint32_t)(g) << 8) | (uint32_t)(b))
+#define HEAD RGB(64, 150, 190)
+#define DONE RGB(24, 70, 90)
+#define DIM  RGB(3, 6, 8)
+
+static int head;        // the spinner's brightest dot
+static int step;        // bar segments lit
+static int phase;       // pulse of the segment in progress
+
+static int8_t row_dots[DOTS];
+static int n_row_dots;
+
+static uint32_t dimmed(uint32_t c, int shift)
+{
+    return ((c >> 16 & 0xff) >> shift) << 16 | ((c >> 8 & 0xff) >> shift) << 8 | (c & 0xff) >> shift;
+}
+
+static uint32_t dot_colour(int k)
+{
+    int age = head - k;
+    if (age < 0)
+        age += DOTS;
+    return age < 5 ? dimmed(HEAD, age) : DIM;
+}
+
+static uint32_t segment_colour(int i)
+{
+    static const uint8_t pulse[8] = { 3, 2, 1, 0, 0, 1, 2, 3 };
+    if (i < step)
+        return DONE;
+    if (i == step)
+        return dimmed(DONE, pulse[phase & 7]);
+    return DIM;
+}
+
+// The dots that reach row y, so scene() only looks at those.
+static void prepare_row(int y)
+{
+    n_row_dots = 0;
+    for (int k = 0; k < DOTS; k++) {
+        int dy = y - (CY + ring[k][1]);
+        if (dy >= -2 && dy <= 2)
+            row_dots[n_row_dots++] = k;
+    }
+}
+
+static uint32_t scene(int x, int y)
+{
+    for (int i = 0; i < n_row_dots; i++) {
+        int k = row_dots[i];
+        int dx = x - (CX + ring[k][0]);
+        if (dx < -2 || dx > 2)
+            continue;
+        int dy = y - (CY + ring[k][1]);
+        if ((dx == 2 || dx == -2) && (dy == 2 || dy == -2))
+            return 0;
+        return dot_colour(k);
+    }
+    if (y >= BAR_Y && y < BAR_Y + SEG_H && x >= BAR_X) {
+        int off = x - BAR_X;
+        for (int i = 0; i < STEPS; i++) {
+            if (off < SEG_W)
+                return segment_colour(i);
+            off -= SEG_W;
+            if (off < SEG_GAP)
+                return 0;
+            off -= SEG_GAP;
+        }
+    }
+    return 0;
+}
+
+// Redraw the whole 64-bit words that cover pixels x0..x1 of row y, in one panel.
+// A framebuffer word holds the host's byte stream (R, G, B, R, ...) first byte
+// highest, the even word of each pair in data_lo; see receiver75's UdpDramWriter.
+static void draw_span(int x0, int x1, int y)
+{
+    int qx = x0 >> 6;
+    int slot = quadrant_slot[y >> 6][qx];
+    int j0 = ((x0 & 63) * 3) >> 3;
+    int j1 = ((x1 & 63) * 3 + 2) >> 3;
+    hub75_soc_fb_address_write((SPLASH_BASE + slot * SLOT_WORDS + (y & 63) * 48) / 2 + j0);
+
+    int p = 0, c = j0 * 8;      // pixel and channel of the first byte, without a divide
+    while (c >= 3) {
+        c -= 3;
+        p++;
+    }
+    uint32_t px = scene(qx * 64 + p, y);
+    for (int j = j0; j <= j1; j++) {
+        uint32_t w[2];
+        for (int h = 0; h < 2; h++) {
+            uint32_t v = 0;
+            for (int b = 0; b < 4; b++) {
+                v = v << 8 | (px >> (16 - 8 * c) & 0xff);
+                if (++c == 3) {
+                    c = 0;
+                    p++;
+                    px = p < 64 ? scene(qx * 64 + p, y) : 0;
+                }
+            }
+            w[h] = v;
+        }
+        hub75_soc_fb_data_lo_write(w[0]);
+        hub75_soc_fb_data_hi_write(w[1]);
+    }
+}
+
+static void draw_rect(int x0, int y0, int x1, int y1)
+{
+    for (int y = y0; y <= y1; y++) {
+        prepare_row(y);
+        if (x0 < 64)
+            draw_span(x0, x1 < 63 ? x1 : 63, y);
+        if (x1 >= 64)
+            draw_span(x0 > 64 ? x0 : 64, x1, y);
+    }
+}
+
+static void draw_dot(int k)
+{
+    int x = CX + ring[k][0], y = CY + ring[k][1];
+    draw_rect(x - 2, y - 2, x + 2, y + 2);
+}
+
+static void draw_segment(int i)
+{
+    int x = BAR_X + i * (SEG_W + SEG_GAP);
+    draw_rect(x, BAR_Y, x + SEG_W - 1, BAR_Y + SEG_H - 1);
+}
+
+static void clear_bank(void)
+{
+    hub75_soc_fb_address_write(SPLASH_BASE / 2);
+    hub75_soc_fb_data_lo_write(0);
+    for (int i = 0; i < SLOTS * SLOT_WORDS / 2; i++)
+        hub75_soc_fb_data_hi_write(0);
+}
+
+static void frame_start(void)
+{
+    timer0_en_write(0);
+    timer0_reload_write(0);
+    timer0_load_write(FRAME_TICKS);
+    timer0_en_write(1);
+}
+
+static void frame_wait(void)
+{
+    do
+        timer0_update_value_write(1);
+    while (timer0_value_read());
+}
+
+void splash_run(void)
+{
+    ctrl_scratch_write(1);
+    step = 1;
+    clear_bank();
+    for (int k = 0; k < DOTS; k++)
+        draw_dot(k);
+    for (int i = 0; i < STEPS; i++)
+        draw_segment(i);
+    hub75_controller_base_addr_write(SPLASH_BASE);
+    hub75_controller_enable_write(1);
+
+    int showing = 1;
+    for (;;) {
+        frame_start();
+        if (hub75_controller_base_addr_read() != SPLASH_BASE || !hub75_controller_enable_read()) {
+            showing = 0;            // the host has the display; leave bank 2 alone
+        } else {
+            uint32_t s = ctrl_scratch_read();
+            int valid = s >= 1 && s <= STEPS;
+            int bar = 0;
+            if (!showing) {         // given back (pf-splash --show): take its step as is
+                showing = 1;
+                if (valid)
+                    step = s;
+                bar = 1;
+            } else if (valid && (int)s > step) {
+                step = s;           // only forward: steps can arrive out of order
+                bar = 1;
+            }
+            if (++head == DOTS)
+                head = 0;
+            phase++;
+            for (int k = 0; k < DOTS; k++)
+                draw_dot(k);
+            if (bar) {
+                for (int i = 0; i < STEPS; i++)
+                    draw_segment(i);
+            } else if (step < STEPS) {
+                draw_segment(step);
+            }
+        }
+        frame_wait();
+    }
+}
