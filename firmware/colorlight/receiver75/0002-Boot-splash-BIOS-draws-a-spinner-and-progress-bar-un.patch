diff --git a/gateware/csr_dram_writer.py b/gateware/csr_dram_writer.py
new file mode 100644
index 0000000..1435c95
--- /dev/null
+++ b/gateware/csr_dram_writer.py
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: MIT
+
+from migen import *
+
+from litedram.frontend.dma import LiteDRAMDMAWriter
+
+
+class CsrDramWriter(Module):
+    '''
+    Lets the CPU write the framebuffer, one 64-bit SDRAM word at a time.
+
+    The 5A-75B grounds the SDRAM's DQM pins, so every write stores a whole
+    native word. A 32-bit store through a Wishbone bridge would clobber the
+    other half; LiteX only gets away with it behind an L2 cache.
+
+    Writing `address` sets the native (64-bit) word address. Each write to
+    `data_hi` commits {data_hi, data_lo} there and steps the address on.
+    data_lo is the even 32-bit word, as in UdpDramWriter.
+    '''
+    def __init__(self, sdram, address, data_lo, data_hi):
+        port = sdram.crossbar.get_port(mode='write', data_width=64)
+        self.submodules.dma = dma = LiteDRAMDMAWriter(port, fifo_depth=16)
+
+        addr = Signal(port.address_width)
+        data = Signal(64)
+        pending = Signal()
+
+        self.comb += [
+            dma.sink.valid.eq(pending),
+            dma.sink.address.eq(addr),
+            dma.sink.data.eq(data),
+        ]
+
+        self.sync += [
+            If(dma.sink.valid & dma.sink.ready,
+                pending.eq(0),
+                addr.eq(addr + 1),
+            ),
+            If(address.re,
+                addr.eq(address.storage),
+            ),
+            If(data_hi.re,
+                data.eq(Cat(data_lo.storage, data_hi.storage)),
+                pending.eq(1),
+            ),
+        ]
